# Optional: enables full Grok chat replies via xAI API
# Get a key at https://console.x.ai
XAI_API_KEY=

# Model for chat (default: grok-4-1-fast-non-reasoning or grok-3-mini)
XAI_MODEL=grok-3-mini

# Portal bind
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8787

# Email shown on reports / UI
REPORT_EMAIL=sawaiz@sawaizsyed.com
